# Lokale Entwicklung (npm run dev): PocketBase läuft bewusst auf Port 8091
# (nicht 8090), damit dieses Projekt parallel zu otherApp (dort: 8090) auf
# demselben Rechner laufen kann.
VITE_POCKETBASE_URL=http://127.0.0.1:8091

# --- Nur für das NAS/docker-compose relevant (siehe INITIAL_DEPLOYMENT.md) ---
# Auf dem NAS eine EIGENE .env mit den Produktionswerten anlegen (NICHT diese
# lokale .env dorthin kopieren):
#   VITE_POCKETBASE_URL=https://wehen-api.familieaschenbrenner.de
#   PROXY_NETWORK_NAME=<Name des Docker-Netzwerks des nginx Proxy Managers>
